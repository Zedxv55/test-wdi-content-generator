PORT=3077
# สายฟรี (แนะนำ) - OpenRouter
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Image generation: reference-capable model (billed per image by provider).
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Paid image calls are OFF unless this is true. Default (absent/false) = demo/free only, no charges possible.
ALLOW_PAID_IMAGE=false
# สายจ่ายเงิน - OpenAI (ถ้าจะใช้)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# ไฟล์ข้อมูล - ใส่ path สัมพัทธ์หรือ absolute ก็ได้
# PRODUCT_FILE=../Present(Get-web-wdi).xlsx
# VIDEO_FILE=../Present(Short-vdo).xlsx
